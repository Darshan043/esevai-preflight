# development, staging, or production
ENVIRONMENT=development
# Comma-separated browser origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
# Version string returned by GET /health
APP_VERSION=0.1.0
# Supabase project URL. Leave empty until a later step.
SUPABASE_URL=
# Supabase service-role key. Leave empty. Never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=
# HS256 signing secret from Project Settings > API > JWT Settings.
# Leave empty. Never commit a real secret.
# Tokens signed with ES256 or RS256 are checked with the project JWKS URL instead.
SUPABASE_JWT_SECRET=
# Anthropic API key. Leave empty. Never commit a real key.
ANTHROPIC_API_KEY=
# Claude model name. Leave empty until a later step.
CLAUDE_MODEL=
# Largest file the API will store, in megabytes. Leave at 5.
MAX_UPLOAD_MB=5
# Optional full path to tesseract.exe. Leave empty to use the system PATH.
TESSERACT_CMD=
# Optional folder that contains pdftoppm. Leave empty to use the system PATH.
POPPLER_PATH=
# Languages Tesseract should read. Default is English plus Tamil.
OCR_LANGS=eng+tam
# Seconds before one OCR call is stopped.
OCR_TIMEOUT_SECONDS=40
# Resolution used when a PDF page becomes an image.
OCR_PDF_DPI=200
# How many PDF pages to read. The real page count is still stored.
OCR_MAX_PDF_PAGES=2
# Reject an image with more pixels than this.
OCR_MAX_PIXELS=25000000

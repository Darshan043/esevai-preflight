# These three names are inlined at Next.js BUILD time. A redeploy is required after changing them.
# Base URL of the FastAPI backend (browser URL, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase project URL. Example shape: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
